# ===== Front-end (build time, injetado pelo webpack) =====
# URL base da API. Em produção na Vercel deixe "/api" (mesma origem).
# Para dev local apontando para "vercel dev", use http://localhost:3000/api
API_BASE_URL=/api

# Supabase para autenticação no front (chaves PÚBLICAS, podem ir no bundle).
# Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# ===== Back-end (Serverless Functions na Vercel) =====
# (SUPABASE_URL acima é reutilizada também no back-end)
# Chave service_role (NUNCA exponha no front-end, só nas functions)
SUPABASE_SERVICE_ROLE_KEY=

# E-mails de administradores da barbearia, separados por vírgula.
# Quem logar com um desses e-mails tem acesso ao painel /admin.
ADMIN_EMAILS=dono@suabarbearia.com

# Resend -> https://resend.com/api-keys
RESEND_API_KEY=
# Remetente verificado no Resend, ex: "Hair Day <agendamentos@suabarbearia.com>"
MAIL_FROM=
# (Opcional) e-mail de resposta/organizador do convite de calendário
MAIL_REPLY_TO=
# (Opcional) nome exibido nos e-mails. Padrão: "Hair Day"
SHOP_NAME=
# (Opcional) fuso para exibir os horários. Padrão: "America/Sao_Paulo"
BARBERSHOP_TZ=America/Sao_Paulo

# ===== WhatsApp via Z-API (Fase 4, opcional) =====
# Sem estas chaves o sistema funciona normal, apenas não envia WhatsApp.
# Painel Z-API > sua instância
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
# "Account Security Token" (header Client-Token), em Z-API > Segurança
ZAPI_CLIENT_TOKEN=
# DDI para números locais. Padrão "55" (Brasil)
WHATSAPP_COUNTRY_CODE=55
